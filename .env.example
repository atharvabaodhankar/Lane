# Server & Environment
PORT=3000
NODE_ENV=development
AWS_REGION=us-east-1

# Fastino API
FASTINO_API_KEY=your_fastino_api_key_here
FASTINO_BASE_URL=https://api.fastino.ai

# Toggle mock services (true = mock responses without network calls; false = live API calls)
MOCK_SERVICES=false

# DynamoDB Table Names
DYNAMODB_REQUESTS_TABLE=lane-requests-dev
DYNAMODB_CACHE_TABLE=lane-cache-dev
DYNAMODB_API_KEYS_TABLE=lane-api-keys-dev

# Security & CORS
JWT_SECRET=your_jwt_secret_here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
